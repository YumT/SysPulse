<Window x:Class="SysPulsar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysPulsar"
        Width="640" Height="580"
        MinWidth="560" MinHeight="500"
        Background="#141414"
        FontFamily="Yu Gothic UI"
        WindowStartupLocation="Manual">
    <!-- Background 必須: 全表示要素を非表示にしたとき Grid 上の右クリックが
         ヒットテストをすり抜けてコンテキストメニューが出なくなるのを防ぐ -->
    <Grid x:Name="Root" Background="#141414"/>
</Window>
